{
  "consumer": {
    "name": "App2-Consumer"
  },
  "interactions": [
    {
      "contents": {
        "content": {
          "counter": 2,
          "message_type": "pong"
        },
        "contentType": "application/json",
        "encoded": false
      },
      "description": "A pong message matching the standard cycle schema",
      "matchingRules": {
